    "es.s.05855224a8a3bc50": {
      "text": "Hace mal tiempo.",
      "origins": []
    },
    "es.s.299abf7c71812040": {
      "text": "Me han seleccionado para una revisión adicional. ¿Podría explicarme el motivo y mis derechos?",
      "origins": []
    },
    "es.s.4abf33c2dd0770a3": {
      "text": "Hola, ¿cómo lo estás llevando?",
      "origins": []
    },
    "es.s.4de816c0bf9e67e5": {
      "text": "No tengo nada en particular que decir.",
      "origins": []
    },
    "es.s.5cc55eb94f20f2b5": {
      "text": "¿Podrías cortar las verduras en trozos pequeños, por favor?",
      "origins": []
    },
    "es.s.9c83443fd729d757": {
      "text": "¿Qué celular me recomiendas?",
      "origins": []
    },
    "es.s.d044329f307ffb40": {
      "text": "El mar está tranquilo hoy.",
      "origins": []
    },
    "es.s.ebb0630ea06afd3b": {
      "text": "Ahora es un adulto.",
      "origins": []
    },
    "es.s.f726ce9a4bc11579": {
      "text": "¿Tienes tu pasaporte listo?",
      "origins": []
    }
  }

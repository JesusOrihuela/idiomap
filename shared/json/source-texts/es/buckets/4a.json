  "sentences": {
    "es.s.002b94b6b3cc58e6": {
      "text": "La tostadora está en la mesa.",
      "origins": []
    },
    "es.s.07e991b17c9911d9": {
      "text": "¿Qué haces los fines de semana?",
      "origins": []
    },
    "es.s.2c27b67848e34a83": {
      "text": "Está al lado del supermercado.",
      "origins": []
    },
    "es.s.4df943053f44c3ee": {
      "text": "¿Me puede dar una bolsa, por favor?",
      "origins": []
    },
    "es.s.54dbae628be04776": {
      "text": "Solicité una copia de todos los datos que la plataforma había recopilado sobre mí, y los resultados fueron inquietantes.",
      "origins": []
    },
    "es.s.58553ab9133225d0": {
      "text": "Hay un banco en la esquina.",
      "origins": []
    },
    "es.s.5a8de9b0c97d99ab": {
      "text": "¿Dónde está la oficina de turismo?",
      "origins": []
    },
    "es.s.9881e8deedab5462": {
      "text": "Tomo un café antes de salir.",
      "origins": []
    },
    "es.s.c392202dac84af16": {
      "text": "Son las tres en punto.",
      "origins": []
    },
    "es.s.cae792c7329a94ec": {
      "text": "Ese esfuerzo valió la pena.",
      "origins": []
    },
    "es.s.cbcd1ed0c4a09866": {
      "text": "Esto es muy especial.",
      "origins": []
    }
  }
}

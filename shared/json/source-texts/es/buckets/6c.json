  "sentences": {
    "es.s.0a46e43f657ce194": {
      "text": "Hay que limpiar la cocina.",
      "origins": []
    },
    "es.s.1fecb312462eaaf9": {
      "text": "¿Tienen política de igualación de precios? Encontré este artículo más barato en otra tienda.",
      "origins": []
    },
    "es.s.2ee6675f7662f418": {
      "text": "El flan debe hornearse en baño maría dentro del horno.",
      "origins": []
    },
    "es.s.54cc9aeec7e44892": {
      "text": "¿Podrías ayudarme a tamizar la harina?",
      "origins": []
    },
    "es.s.708e5df6e8e070ad": {
      "text": "Estoy de acuerdo contigo.",
      "origins": []
    },
    "es.s.77e1064bd795f296": {
      "text": "Debemos llegar a un acuerdo.",
      "origins": []
    },
    "es.s.83a5ea173fb66ad4": {
      "text": "La habitación asignada no coincide con mi reserva. Me gustaría hablar con el gerente.",
      "origins": []
    },
    "es.s.b98b4ed289f5545a": {
      "text": "Buenas tardes, ¿cómo has estado?",
      "origins": []
    },
    "es.s.bdfa9e6bca79dbfa": {
      "text": "El abogado revisó el contrato.",
      "origins": []
    },
    "es.s.f9e47a38cda2354c": {
      "text": "Tengo las manos frías.",
      "origins": []
    },
    "es.s.fb1e4f00970efee7": {
      "text": "¡Adiós!",
      "origins": []
    }
  }
}

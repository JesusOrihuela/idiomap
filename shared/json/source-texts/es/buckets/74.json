      "text": "¡No te pierdas!",
      "origins": []
    },
    "es.s.3058eb6a697b6fb6": {
      "text": "Quítate el abrigo.",
      "origins": []
    },
    "es.s.39a24f131cdde536": {
      "text": "Para cocinar mejor el pollo hay que bridar sus patas.",
      "origins": []
    },
    "es.s.434c21837a942c2c": {
      "text": "No esperaba verte aquí. ¡Qué agradable sorpresa!",
      "origins": []
    },
    "es.s.500d25048f79fea8": {
      "text": "¿A qué te dedicas?",
      "origins": []
    },
    "es.s.d7e1825dfee658fa": {
      "text": "Hace fresco por la mañana.",
      "origins": []
    }

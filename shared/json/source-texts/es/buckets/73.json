    "es.s.0f6a6d6402a48a7c": {
      "text": "¡Ve al grano!",
      "origins": []
    },
    "es.s.41e24be6c2eb2c36": {
      "text": "No esperes hasta el final para sazonar. Prueba y ajusta durante toda la cocción.",
      "origins": []
    },
    "es.s.59e1ae7ee6373171": {
      "text": "Es un buen tipo.",
      "origins": []
    },
    "es.s.8b7f339b26f029bf": {
      "text": "Este lugar es enorme.",
      "origins": []
    },
    "es.s.9c0e4ba2a9e5f2d2": {
      "text": "Según el Reglamento UE 261/2004, creo que tengo derecho a compensación por esta cancelación.",
      "origins": []
    },
    "es.s.b4273ea3f18fb69a": {
      "text": "Él es mi vecino.",
      "origins": []
    },
    "es.s.b78b74a7bfea819b": {
      "text": "Deberías cuidar tu salud.",
      "origins": []
    },
    "es.s.d88e485a09311579": {
      "text": "No sé dónde está la batería portátil.",
      "origins": []
    },
    "es.s.ebef56eb7a50c9a0": {
      "text": "Vivo con mi pareja.",
      "origins": []
    },
    "es.s.f61672860ac9a9b6": {
      "text": "¿Por qué estás nervioso/a?",
      "origins": []
    }
  }

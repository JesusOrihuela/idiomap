  "sentences": {
    "de.s.19d89880832eb739": {
      "text": "Meine Großeltern feiern ihren Jahrestag.",
      "origins": []
    },
    "de.s.271640c2f1563667": {
      "text": "Ich muss bald eine Entscheidung treffen.",
      "origins": []
    },
    "de.s.45b6e14dafeef788": {
      "text": "Die Bibliothek ist bis zehn geöffnet.",
      "origins": []
    },
    "de.s.8aba9be3af62592f": {
      "text": "Der Frühling ist meine Lieblingsjahreszeit.",
      "origins": []
    },
    "de.s.a6b6eaf2eb496cc0": {
      "text": "Ich zahle immer lieber bar.",
      "origins": []
    },
    "de.s.af0b9e216beac616": {
      "text": "Die Gäste dürfen den Pool benutzen.",
      "origins": []
    },
    "de.s.ed05194c1f5e7780": {
      "text": "Ich weiß nicht.",
      "origins": []
    }
  }
